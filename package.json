{
  "name": "flowbudget",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @flowbudget/api --filter @flowbudget/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @flowbudget/web test:e2e",
    "db:generate": "pnpm --filter @flowbudget/api prisma generate",
    "db:migrate": "pnpm --filter @flowbudget/api prisma migrate dev",
    "db:seed": "pnpm --filter @flowbudget/api db:seed",
    "audit:deps": "pnpm audit --audit-level high"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.0.1",
    "eslint-config-prettier": "10.1.8",
    "globals": "16.4.0",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0"
  }
}
